*.exe
# Root .env holds deploy-time secrets (OAuth client, SMTP, Maps key) and is
# read by compose for build-arg interpolation. Never commit it.
/.env
/.env.local
server/logs.log
.DS_Store
server/server
# `go build ./tools/...` drops each tool's binary in server/ alongside the
# server one. Named individually rather than globbing, so a real file is never
# silently ignored.
server/mintsession
deploy_scripts/reboot_log.txt
.keys
*.log
# e2e/ runs against a live instance: the saved session is a real cookie and the
# screenshots are of real member data. Neither belongs in a public repo.
e2e/node_modules
e2e/*state*.json
e2e/*.png
# `scripts/browser-check.sh --shots shots` (TODO3 M1), which is how CI runs it.
# Pictures of a seeded club; frontend/shots is covered by frontend/.gitignore.
/shots
