# Google oauth 
# - Create a Google Cloud project, create credentials for a "web application", and put the client id and secret here
# - Your project should have the following scopes: 
#     "./auth/calendar.events.readonly"
#     "./auth/calendar.calendarlist.readonly"
#     "./auth/contacts.readonly"
#     "./auth/directory.readonly"
CLIENT_ID=?
CLIENT_SECRET=?
ANDROID_CLIENT_ID=? # unused
IOS_CLIENT_ID=? # unused

# Gmail — the only mail transport. Sends the email sign-in (OTP) codes,
# invitations, pre-gathering reminders, remindee nudges and the response
# notifications, via SMTP (smtp.gmail.com:587)
GMAIL_APP_PASSWORD=? # required for email OTP auth: 16-char Google App Password (needs 2-Step Verification)
SCHEJ_EMAIL_ADDRESS=? # required for email OTP auth: the @gmail.com address that sends the codes (the "From")

# Email scheduler (services/reminders): pre-gathering reminders and remindee
# nudges. Runs only when the two Gmail vars above are set; otherwise it logs and
# no-ops.
REMINDER_SCHEDULER_INTERVAL=? # optional Go duration (e.g. "5m", "15m"); how often to check for due reminders. Default 5m.

# Encryption
ENCRYPTION_KEY=? # Used to encrypt and decrypt sensitive data

# Session
# - Generate a random 32+ character string for session cookie encryption
# - Example generation: openssl rand -base64 32
SESSION_SECRET=?

# CORS
# - Comma-separated list of allowed origins
# - For local development, set to: http://localhost:8080
CORS_ORIGINS=?

# Invite-only access control
# - When true, the allowlist gate is strictly enforced: an empty allowlist
#   denies everyone (fail closed) instead of failing open for bootstrap.
# - Also gates anonymous writes (E1): when true, creating an event and
#   scheduling an owner-less event require a signed-in member; guests can still
#   respond/RSVP to existing events. When false (dev/open), those stay open.
# - Leave unset/false until the allowlist has been seeded, then set to true.
INVITE_ONLY_ENFORCED=? # optional (true in production once the allowlist is seeded)